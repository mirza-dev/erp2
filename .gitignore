# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local planning docs (not for repo)
yuksek-etki.md

# Supabase local/link cache
supabase/.temp/

# Playwright
tests/.auth/
test-results/
playwright-report/
tests/fixtures/invalid.txt
results/

# Gerçek PMT katalog/sertifika dosyaları — public repo'ya GİRMEZ (seed bunlardan türetildi)
pmt/

# Yerel çalışma alanları — repoya girmemeli.
# (gitignore satır-sonu yorumu desteklemez; yorumlar kendi satırında.)
# git worktree checkout'ları — 270MB
/.claude/worktrees/
# KOBİ simülasyon harness çalışma durumu (Chromium profilleri) — 38MB
/.sim/
# editör yapılandırması
/.obsidian/
# Supabase yedekleri — müşteri verisi, fiyatlar ve OAuth token'ları içerir
/backups/
